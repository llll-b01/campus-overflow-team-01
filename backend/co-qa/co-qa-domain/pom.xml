<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.campusoverflow</groupId>
        <artifactId>co-qa</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>co-qa-domain</artifactId>
    <packaging>jar</packaging>
    <name>Q&amp;A 问答核心 :: domain（纯 Java）</name>
    <properties>
        <!--
          Sprint 1 结束时启用领域层覆盖率门禁（指导书 V2 第 8.3 节）。
          父 POM 默认 0，这里按模块覆盖；Sprint 3 再统一把根 POM 提到 0.70。
          当前实测行覆盖 93.2%（207/222）、分支 91.4%（64/70），离 0.70 有充足余量。
        -->
        <domain.coverage.minimum>0.70</domain.coverage.minimum>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-shared-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-domain-coverage</id>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${domain.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
